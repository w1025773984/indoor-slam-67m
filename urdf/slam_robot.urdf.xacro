<?xml version="1.0"?>
<!--
  SLAM 机器人 URDF（借鉴 oomwoo-one 模块化设计）
  - params.xacro：参数
  - inertial.xacro：惯性宏
  - materials.xacro：材质
  - wheels.xacro：底盘 / 轮子宏
  - sensors.xacro：传感器宏
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="slam_robot">

  <!-- 加载子模块 -->
  <xacro:include filename="$(find indoor_slam_67m)/urdf/xacro/params.xacro"/>
  <xacro:include filename="$(find indoor_slam_67m)/urdf/xacro/materials.xacro"/>
  <xacro:include filename="$(find indoor_slam_67m)/urdf/xacro/inertial.xacro"/>
  <xacro:include filename="$(find indoor_slam_67m)/urdf/xacro/wheels.xacro"/>
  <xacro:include filename="$(find indoor_slam_67m)/urdf/xacro/sensors.xacro"/>

  <!-- 底盘主体 -->
  <xacro:base_body base_length="${base_length}"
                   base_width="${base_width}"
                   base_height="${base_height}"
                   base_mass="${base_mass}"/>

  <!-- 驱动轮 -->
  <xacro:drive_wheel side="left"  wheel_radius="${wheel_radius}" wheel_mass="${wheel_mass}" y_position="${base_width/2 + base_width/8}"/>
  <xacro:drive_wheel side="right" wheel_radius="${wheel_radius}" wheel_mass="${wheel_mass}" y_position="${-(base_width/2 + base_width/8)}"/>

  <!-- 万向轮（前 + 后） -->
  <xacro:caster_wheel position="front" caster_radius="${caster_radius}" x_position="${base_length/2 - 0.05}"/>
  <xacro:caster_wheel position="back"  caster_radius="${caster_radius}" x_position="${-(base_length/2 - 0.05)}"/>

  <!-- 传感器 -->
  <xacro:laser_sensor x="0" y="0" z="${laser_height}"/>
  <xacro:imu_sensor   x="0" y="0" z="${imu_height}"/>

</robot>