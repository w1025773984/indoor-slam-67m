<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="slam_robot">

  <xacro:arg name="name" default="slam_robot"/>
  <xacro:arg name="use_sim_time" default="false"/>

  <!-- 加载主 URDF -->
  <xacro:include filename="$(find indoor_slam_67m)/urdf/slam_robot.urdf.xacro"/>

  <!-- ros2_control 硬件接口（ESP32 透明硬件） -->
  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_separation" value="0.30"/>

  <ros2_control name="esp32_hw" type="system">
    <hardware>
      <plugin>esp32_hardware/ESP32HardwareInterface</plugin>
      <param name="wheel_radius">${wheel_radius}</param>
      <param name="wheel_separation">${wheel_separation}</param>
    </hardware>

    <joint name="wheel_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wheel_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>